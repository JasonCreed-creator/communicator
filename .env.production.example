# ── MICE 커뮤니케이터 운영 환경 변수 (설계서 §18-5 · §20 T2) ──
#
# 이 파일은 **예시**다. 실제 값은 Vercel 프로젝트의 Environment Variables에 넣는다 —
# 레포에 커밋하지 않는다(.env.local·.env.production은 .gitignore 대상).
#
# 넣는 곳: Vercel → 프로젝트 → Settings → Environment Variables
# 적용 대상: Production · Preview 둘 다 (Preview는 dev Supabase를 가리키게 두면 안전하다)
#
# ★ 값을 바꾼 뒤에는 **재배포해야 반영된다.** VITE_* 는 런타임이 아니라 **빌드 타임**에
#   번들로 구워지기 때문이다. Vercel에서 env만 고치고 재배포하지 않으면 옛 값이 계속 산다.

# ── 데이터 공급자 ────────────────────────────────────────────────
# mock      = 서버 없이 픽스처로 동작. 새로고침하면 변경이 사라진다
# supabase  = 실제 DB(Phase 4). 아래 Supabase 값이 전부 있어야 앱이 뜬다
VITE_DATA_PROVIDER=mock

# ── Supabase (VITE_DATA_PROVIDER=supabase일 때 필수) — 설계서 §12 신형 키 체계 ──
# Supabase → Project Settings → API. publishable = sb_publishable_… (브라우저 안전, RLS가 지킨다).
# 레거시 anon/service_role JWT 키는 쓰지 않는다(2026년 말 폐기 예정).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# 로그인 화면이 먼저 안내하는 허용 이메일 도메인(쉼표 구분, 비우면 제한 없음).
# 서버측 정본은 DB app_config.allowed_email_domains(setup.sql 머리말 SQL 1줄) — 둘을 같게 둔다.
VITE_AUTH_ALLOWED_DOMAINS=
# Vercel Functions 기본 경로. 비우면 {VITE_BASE_PATH}api(기본 /api) — 같은 오리진이면 비워 둔다
VITE_API_BASE=
# ── Phase 4.4 회사 도메인 하위 경로(설계서 §18a) ──
# 앱을 도메인 루트가 아닌 하위 경로에서 연다: 예) /leadgen/communicator/ (회사 CloudFront가 이 경로를 Vercel로 넘긴다).
# 비우면 '/'(지금과 같음). 빌드 타임 값이라 바꾸면 재배포. 설정하면 Vercel 주소 루트(/)는 이 경로로 옮겨 간다.
VITE_BASE_PATH=

# ── 서버 전용(Vercel Functions: api/quote-recalc · api/sheets) — VITE_ 접두어 없음 → 번들에 실리지 않는다 ──
# SUPABASE_URL은 VITE_SUPABASE_URL과 같은 값. secret = sb_secret_… (Settings → API Keys, 눈 아이콘으로 표시 후 복사)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# 등록 시트 읽기(§24) + 견적서 → 구글 스프레드시트 생성(api/quote-gsheet) — 구글 서비스 계정 JSON 전문.
# 비우면 시트 읽기는 데모 모드, 견적 시트 생성은 503("아직 준비되지 않음") 안내(D-Day §20 T4b에서 주입)
GOOGLE_SHEETS_SA_JSON=
# 견적 스프레드시트 저장 폴더 id. v2.9: Drive 저장소가 연결돼 있으면 비워 둔다(저장소 루트 00_견적서).
# 서비스 계정 경로라면 공유 드라이브 폴더여야 한다 — 서비스 계정은 저장 용량이 없어 내 드라이브 폴더에 만들 수 없다(Google 문서, 2026-09-24)
GOOGLE_QUOTE_FOLDER_ID=
# 'false'면 요청자(로그인 이메일)에게 편집자 공유를 걸지 않는다. 기본은 공유(만든 사람이 내 드라이브 '공유 문서함'에서 바로 찾는다)
GOOGLE_QUOTE_SHARE_WITH_REQUESTER=

# ── Phase 5 Drive 저장소(api/drive · 설계서 v2.9 §7 · §20 T4) — 서버 전용 ──
# 저장소 루트 폴더 id — 2026-09-24 사용자 지정 폴더(MICE Communicator) 링크의 folders/ 뒤 값
DRIVE_ROOT_FOLDER_ID=
# GCP OAuth 클라이언트(웹, 동의 화면 Internal 권장) — 승인된 리디렉션 URI = https://{운영 도메인}{VITE_BASE_PATH}api/drive
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 비워 두고 관리자가 앱에서 "Drive 연결하기"(갱신 토큰은 Supabase Vault) — env로 넣을 때만 채운다
GOOGLE_DRIVE_REFRESH_TOKEN=
# (선택) DRIVE_AUTH=service_account(공유 드라이브 전용) · DRIVE_MAX_UPLOAD_MB(기본 2048) · DRIVE_SIGNING_KEY
DRIVE_AUTH=
DRIVE_MAX_UPLOAD_MB=
# 회사 도메인(CloudFront 경유)이면 **필수** — 함수는 Vercel 주소로 요청을 받아 회사 주소를 모른다.
#   예) https://mkt.rememberapp.co.kr/leadgen/communicator/api/drive (GCP 승인된 리디렉션 URI와 글자까지 같게)
#   연결 뒤 행사 설정으로 돌아가는 주소도 여기서 뽑는다(…/api/drive → …/settings)
DRIVE_OAUTH_REDIRECT_URI=

# ── Phase 4.3 시험용 입구(설계서 §12.1) — Okta SSO 전까지의 임시 입구. 서버 전용(VITE_ 금지) ──
# 둘 다 맞아야 열린다: AUTH_GATE=open + AUTH_GATE_UNTIL(닫히는 시각, 지금부터 14일 이내 — 넘으면 열리지 않는다).
#   예) AUTH_GATE_UNTIL=2026-09-28T18:00:00+09:00
# 열려 있는 동안 로그인 화면에 주소록 인물 카드가 뜨고 **누구나** 골라 들어온다(암호 없음 — 2026-09-25 사용자 결정).
# 닫기 = AUTH_GATE를 지우거나 기한이 지나면 자동. 바꾼 뒤 재배포.
AUTH_GATE=
AUTH_GATE_UNTIL=

# ── 절대 VITE_ 접두어로 넣지 않는 것 ─────────────────────────────
# VITE_ 접두사가 붙은 값은 **브라우저 번들에 그대로 실린다.** 누구나 볼 수 있다.
#   - Supabase secret key (sb_secret_…)
#   - 구글 서비스 계정 JSON · 견적 시트 폴더 id · Google Drive OAuth client secret·refresh token (Phase 5)
#   - Slack Incoming Webhook URL (Phase 6) · Resend API key (Phase 6b)
# 서버 시크릿을 VITE_* 로 노출하면 그 자체로 사고다 — 이름만 바꿔서도 넣지 말 것.
