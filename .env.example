# ── MICE 커뮤니케이터 환경 변수 (예시 파일 — 실제 값은 .env.local에, 커밋 금지) ──

# 데이터 공급자 선택: mock | supabase  (기본 mock — 데모·테스트는 mock으로 돈다)
VITE_DATA_PROVIDER=mock

# ── Phase 4 Supabase (VITE_DATA_PROVIDER=supabase일 때 필수) — 설계서 §12 신형 키 체계 ──
# Project Settings → API. 레거시 anon/service_role JWT 키는 쓰지 않는다(2026년 말 폐기 예정).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# 로그인 화면이 먼저 안내하는 허용 이메일 도메인(쉼표 구분, 비우면 제한 없음).
# 서버측 정본은 DB app_config.allowed_email_domains(setup.sql 머리말 참조) — 둘을 같게 둔다.
VITE_AUTH_ALLOWED_DOMAINS=
# Vercel Functions 기본 경로(견적 서버 재계산 등). 같은 오리진이면 비워 둔다(/api).
VITE_API_BASE=

# ── 서버 전용(Vercel 프로젝트 env · 로컬 검증 스크립트) — 절대 VITE_ 접두어를 붙이지 않는다 ──
# SUPABASE_URL은 VITE_SUPABASE_URL과 같은 값. secret 키는 api/ 함수와 scripts/만 읽는다.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# 구글 서비스 계정 JSON 전문 — 등록 시트 읽기(§24)와 견적서 → 구글 스프레드시트 생성(api/quote-gsheet)이 공유한다.
# 비우면 시트 읽기는 데모 모드, 견적 시트 생성은 "아직 준비되지 않음"(503) 안내.
GOOGLE_SHEETS_SA_JSON=
# 견적 스프레드시트를 만들 Drive 폴더 id. v2.9: Drive 저장소(아래)가 연결돼 있으면 비워 둔다 — 저장소 루트의 00_견적서에 만든다.
# 서비스 계정 경로(저장소 미연결)라면 **공유 드라이브** 폴더여야 한다(서비스 계정은 저장 용량이 없어 내 드라이브 폴더에 못 만든다).
GOOGLE_QUOTE_FOLDER_ID=
# 'false'면 만든 시트를 요청자 이메일에 편집자로 공유하지 않는다(공유 드라이브 폴더라 이미 보이는 경우). 기본 공유.
GOOGLE_QUOTE_SHARE_WITH_REQUESTER=

# ── Phase 5 Drive 저장소(api/drive · 설계서 v2.9 §7) — 서버 전용 ──
# 저장소 루트 폴더 id(폴더 링크 drive.google.com/drive/folders/<id> 의 <id>). 비우면 Drive 기능 전체가 "설정 전"(503 안내).
DRIVE_ROOT_FOLDER_ID=
# GCP OAuth 클라이언트(웹) — 승인된 리디렉션 URI: https://{앱 도메인}/api/drive (로컬이면 http://localhost:5173/api/drive는 쓰지 않는다 — vercel dev 주소)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# (선택) 갱신 토큰을 env로 넣을 때만. 비우면 관리자가 앱 행사 설정 ③ "Drive 연결하기"로 동의 → Supabase Vault에 저장된다(권장)
GOOGLE_DRIVE_REFRESH_TOKEN=
# (선택) service_account면 GOOGLE_SHEETS_SA_JSON으로 접근 — 저장소가 **공유 드라이브**일 때만(서비스 계정은 저장 용량 없음)
DRIVE_AUTH=
# (선택) 업로드 상한 MB(기본 2048) · 서명 키(비우면 SUPABASE_SECRET_KEY에서 파생) · 리디렉션 URI 고정(프록시 뒤 등)
DRIVE_MAX_UPLOAD_MB=
DRIVE_SIGNING_KEY=
DRIVE_OAUTH_REDIRECT_URI=

# 주의: Drive 토큰·Slack Webhook·Resend 키(Phase 5~6)도 서버 전용 env로만 관리한다.
