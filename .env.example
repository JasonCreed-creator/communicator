# ── MICE 커뮤니케이터 환경 변수 (예시 파일 — 실제 값은 .env에, 커밋 금지) ──

# 데이터 공급자 선택 (Phase 1부터 사용): mock | supabase
VITE_DATA_PROVIDER=mock

# ── Phase 4+ (Supabase 이식 시) — Phase 0~3은 서버 0, 비워둠 ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 주의: service role key·Drive 토큰 등 서버 시크릿은 프론트 env(VITE_*)에 절대 넣지 않는다.
# Drive OAuth·Slack Webhook·Resend 키는 Phase 5~6에서 Supabase Edge Functions 시크릿으로만 관리.
