{
  "name": "mice-communicator",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "demo:typecheck": "tsc --noEmit -p tsconfig.demo.json",
    "demo:build": "npm run demo:typecheck && env -u VITE_DATA_PROVIDER vite build --config vite.demo.config.ts",
    "demo:check": "node demo/verify/check-artifact.mjs",
    "demo:check:routing": "vitest run --config demo/verify/vitest.config.ts",
    "demo:check:browser": "node demo/verify/browser-check.mjs",
    "demo:serve": "node demo/verify/serve.mjs",
    "demo:smoke": "node demo/verify/interaction-smoke.mjs",
    "demo": "npm run demo:build && npm run demo:check && npm run demo:check:routing && npm run demo:check:browser"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/file-saver": "^2.0.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
